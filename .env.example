# Skopiuj ten plik do .env:  cp .env.example .env
# Plik .env NIE trafia do repo (jest w .gitignore).

# --- Django ---
DJANGO_DEBUG=True
# Na produkcji wygeneruj własny klucz:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=zmien-mnie-na-losowy-ciag-znakow
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=redhero
POSTGRES_USER=redhero
POSTGRES_PASSWORD=redhero
# "db" to nazwa serwisu bazy w docker-compose.yml
POSTGRES_HOST=db
POSTGRES_PORT=5432
